# URL base da API do backend (ver docs/FRONTEND.md §4). Opcional: se vazio/
# ausente, lib/api/apiBaseUrl.ts deriva "http://<hostname da página>:8000"
# em tempo de execução no navegador (funciona em localhost, IP da LAN e
# domínio DuckDNS sem precisar reconfigurar). Só preencha aqui se o backend
# estiver num host ou porta diferente do padrão.
NEXT_PUBLIC_API_BASE_URL=
