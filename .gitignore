# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Env / segredos
.env
backend/secrets/

# RAG uploads (dados de usuário, não versionados)
backend/data/
data/
uploads/

# Manuais de fornecedores (material de terceiros, só uso local/fixture de
# teste — não deve subir para o GitHub; alguns arquivos passam de 50-100MB)
docs/Manuais_fornecedor/

# Node / Next.js
node_modules/
.next/
frontend/dist/
frontend/build/

# Artefatos do sistema/WSL
*:Zone.Identifier

# Editor
.vscode/
.idea/
.worktrees/

# Antigravity CLI / ferramentas externas
.antigravitycli/
install.cmd
%NVM_HOME%PATH.txt

# Segredos do Caddy (token do DuckDNS)
infra/caddy/caddy.env

# Ferramentas locais de agente / memória
.headroom/
.serena/
.repowise/
.claude/.headroom_wrap*
# Instrucoes e config auto-geradas pelo Repowise (`repowise init` + hook de
# post-commit): regravadas a cada commit e com caminho absoluto da maquina
# no .mcp.json — cada maquina gera as suas. Manual: docs/Manuais/repowise-manual.md
.claude/CLAUDE.md
.mcp.json
.github/copilot-instructions.md

# Graphify: saída inteira é regenerável pelo hook post-commit (não versionar)
graphify-out/
# (linhas abaixo ficam por compatibilidade)
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/[0-9][0-9][0-9][0-9]-*/
graphify-out/*.sig
