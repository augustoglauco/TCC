# Proxy local da Web UI do Repowise para a tela /admin/ferramentas.
#
# Por que existe: o site é aberto por https/http público
# (augustoglauco.duckdns.org:3001) e embute http://localhost:3002 num iframe.
# O Chrome trata isso como "rede pública -> rede privada" (Private Network
# Access) e só deixa passar se o destino responder com
# `Access-Control-Allow-Private-Network: true` — o GitNexus já manda o
# cabeçalho, o Next.js do Repowise não. Este proxy escuta na 3002 e repassa
# para a UI real, que sobe na 3012 (`repowise serve --ui-port 3012`), só
# acrescentando o cabeçalho e respondendo ao preflight.
#
# Só 127.0.0.1: continua sem exposição à internet (a 3002 não é encaminhada
# no roteador; o iframe é carregado pelo navegador da própria máquina).
#
# Subir: ~/.local/bin/caddy run --config infra/caddy/Caddyfile.repowise --adapter caddyfile

{
	admin off
	auto_https off
}

http://127.0.0.1:3002, http://localhost:3002 {
	bind 127.0.0.1

	header Access-Control-Allow-Private-Network "true"

	@preflight method OPTIONS
	handle @preflight {
		header Access-Control-Allow-Origin "{http.request.header.Origin}"
		header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		header Access-Control-Allow-Headers "*"
		header Vary "Origin"
		respond 204
	}

	reverse_proxy 127.0.0.1:3012
}
