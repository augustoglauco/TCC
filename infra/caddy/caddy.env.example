# Copie para infra/caddy/caddy.env (fora do git) e preencha.
# Domínio DuckDNS, sem https:// e sem porta:
DUCKDNS_DOMAIN=seu-dominio.duckdns.org
# Token da sua conta em https://www.duckdns.org (topo da página, "token").
# É um segredo: quem o tiver pode apontar o seu domínio para outro lugar.
DUCKDNS_TOKEN=troque-pelo-token-do-duckdns
