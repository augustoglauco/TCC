# Copie para .env e preencha localmente — nunca commitar .env com valores reais.

# --- Aplicação ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Modelo local (R1) ---
LOCAL_MODEL_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=llama3.1:8b

# --- Modelo externo via OpenRouter (roteador, R3) ---
EXTERNAL_MODEL_BASE_URL=https://openrouter.ai/api/v1
EXTERNAL_MODEL_API_KEY=changeme
# MVP: sem default — formato "provider/model" (ex.: anthropic/claude-3.5-haiku)
EXTERNAL_MODEL_NAME=
EXTERNAL_MODEL_PRICE_PER_1K_INPUT_TOKENS=0.0
EXTERNAL_MODEL_PRICE_PER_1K_OUTPUT_TOKENS=0.0

# --- Roteador: estratégia de classificação (R3) ---
ROUTER_COMPLEXITY_STRATEGY=heuristic
LOCAL_LLM_TIMEOUT_S=30.0
EXTERNAL_LLM_TIMEOUT_S=30.0

# --- STT local via faster-whisper (R5) ---
# MVP: tamanho fixo, sem troca automática por VRAM disponível em runtime
STT_MODEL_SIZE=small

# --- Qdrant (RAG texto/imagem, R4) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- PostgreSQL (conector RAG R4, memória R9, perfil R10, catálogo MCP B2B R12) ---
POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/assistente

# --- MCP cliente: Google Calendar (R11) ---
GOOGLE_CALENDAR_CREDENTIALS_PATH=./secrets/google_calendar_credentials.json
GOOGLE_CALENDAR_CALENDAR_ID=primary

# --- MCP servidor B2B (R12) ---
# MVP: uso interno, sem autenticação por parceiro (ver docs/ARCHITECTURE.md §6)
MCP_B2B_HOST=0.0.0.0
MCP_B2B_PORT=8100

# --- CORS (frontend) ---
# MVP: origem única de dev — sem lista configurável por ambiente/parceiro
CORS_ALLOWED_ORIGIN=http://localhost:3000
