# Copie para .env e preencha localmente — nunca commitar .env com valores reais.

# --- Aplicação ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Modelo local (R1) ---
LOCAL_MODEL_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=llama3.1:8b

# --- Modelo externo (roteador, R3) ---
EXTERNAL_MODEL_BASE_URL=https://api.openai.com/v1
EXTERNAL_MODEL_API_KEY=changeme
EXTERNAL_MODEL_NAME=gpt-4o-mini

# --- Qdrant (RAG texto/imagem, R4) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- PostgreSQL (conector RAG R4, memória R9, perfil R10, catálogo MCP B2B R12) ---
POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/assistente

# --- MCP cliente: Google Calendar (R11) ---
GOOGLE_CALENDAR_CREDENTIALS_PATH=./secrets/google_calendar_credentials.json
GOOGLE_CALENDAR_CALENDAR_ID=primary

# --- MCP servidor B2B (R12) ---
# MVP: uso interno, sem autenticação por parceiro (ver docs/ARCHITECTURE.md §6)
MCP_B2B_HOST=0.0.0.0
MCP_B2B_PORT=8100
