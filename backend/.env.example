# Copie para .env e preencha localmente — nunca commitar .env com valores reais.

# --- Aplicação ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Modelo local (R1) ---
LOCAL_MODEL_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=llama3.1:8b

# --- Modelo externo via OpenRouter (roteador, R3) ---
EXTERNAL_MODEL_BASE_URL=https://openrouter.ai/api/v1
EXTERNAL_MODEL_API_KEY=changeme
# MVP: sem default — formato "provider/model" (ex.: anthropic/claude-3.5-haiku)
EXTERNAL_MODEL_NAME=
EXTERNAL_MODEL_PRICE_PER_1K_INPUT_TOKENS=0.0
EXTERNAL_MODEL_PRICE_PER_1K_OUTPUT_TOKENS=0.0

# --- Identificação de produto por imagem (R6) ---
# Padrão: imagem espontânea = identificação de produto; OCR só quando o
# sistema solicita comprovante (ver docs/ARCHITECTURE.md §4). Defaults abaixo
# só populam o frontend; ajustáveis em runtime via /admin/modelos.
# Modelo de visão via OpenRouter (formato "provider/model"); vazio desliga o
# fallback externo (motor responde "não identificado" sem chamar o externo).
EXTERNAL_VISION_MODEL_NAME=
# Limiar alto de aceite do catálogo interno (CLIP)
IMAGE_INTERNAL_CONFIDENCE=0.30
# Confiança mínima reportada pelo modelo de visão externo para aceitar
IMAGE_EXTERNAL_CONFIDENCE=0.80

# --- Roteador: estratégia de classificação (R3) ---
ROUTER_COMPLEXITY_STRATEGY=heuristic
LOCAL_LLM_TIMEOUT_S=30.0
EXTERNAL_LLM_TIMEOUT_S=30.0

# --- Provedor alternativo do classificador — TypeSafe Jev via OpenRouter ---
# Fora do MVP original, ver docs/ARCHITECTURE.md §5 (decisão 2026-09-23).
# Reaproveita EXTERNAL_MODEL_API_KEY acima (mesma conta OpenRouter); chamado
# via endpoint dedicado POST /api/v1/systemone, não /chat/completions. O til
# faz parte do slug do modelo (não é um artefato de URL) — sem ele o
# OpenRouter devolve 400 "Model ... does not exist".
JEV_MODEL_NAME=~typesafe/jev-latest
# Orçamento de timeout próprio (menor que EXTERNAL_LLM_TIMEOUT_S) — Jev é um
# modelo "System One" de decisão rápida, não um LLM de chat.
JEV_TIMEOUT_S=10.0

# --- Monitor de Tom (R8, Fase 4B) ---
# Fora do MVP original, ver docs/ARCHITECTURE.md §5 (decisão 2026-09-23) e
# docs/superpowers/specs/2026-09-23-monitor-de-tom-design.md. Mesmo padrão de
# dois provedores do classificador de intenção acima
# (heuristica_llm/jev_openrouter).
TONE_MONITOR_ENABLED=true
TONE_MONITOR_PROVIDER=heuristica_llm

# --- STT local via faster-whisper (R5) ---
# MVP: tamanho fixo, sem troca automática por VRAM disponível em runtime
STT_MODEL_SIZE=small

# --- Qdrant (RAG texto/imagem, R4) ---
QDRANT_HOST=localhost
QDRANT_PORT=6335
QDRANT_TIMEOUT_S=10.0
# Desligado por padrão (false): busca de RAG filtrada por domínio que não
# acha nada permanece vazia (sinal usado pelo roteador pra escalar pro
# modelo externo, ver docs/ARCHITECTURE.md). Ligar (true) faz uma segunda
# busca SEM filtro de domínio quando a filtrada vem vazia — sacrifica
# isolamento entre domínios e corrompe esse sinal; só para
# comparação/experimento.
RAG_SEARCH_DOMAIN_FALLBACK=false

# --- RAG: armazenamento de arquivos originais para reingestão (além do MVP) ---
# MVP: disco local gerenciado pelo processo do backend, sem object storage
RAG_UPLOADS_DIR=./data/rag_uploads

# --- Crawler de páginas (RAG, R4) ---
# MVP: teto default de páginas por execução — sem limite rígido no backend,
# o admin pode pedir mais por execução via form
CRAWLER_MAX_PAGES=20
# Limiar de confiança do classificador: acima ingere direto, abaixo vai pra
# fila de revisão manual
CRAWLER_CONFIDENCE_THRESHOLD=0.7

# --- PostgreSQL (conector RAG R4, memória R9, perfil R10, catálogo MCP B2B R12) ---
POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@localhost:5433/assistente

# --- MCP cliente: Google Calendar (R11) ---
# Servidor MCP de terceiro `calendar-mcp-server` rodando localmente (não o
# MCP oficial do Google — em Developer Preview, não aceita Gmail pessoal,
# ver docs/ARCHITECTURE.md §5). Suba com:
#   uvx calendar-mcp-server auth   # uma vez, gera o token
#   uvx calendar-mcp-server serve --transport http --port 8090
# GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET (do mesmo OAuth "Desktop app" client)
# são lidos pelo próprio calendar-mcp-server no ambiente que o inicia, não
# por este backend.
CALENDAR_MCP_URL=http://127.0.0.1:8090/mcp
GOOGLE_CALENDAR_CALENDAR_ID=primary

# --- Validação de horário do agendamento (R11) ---
AGENDAMENTO_TIMEZONE=America/Sao_Paulo
AGENDAMENTO_EXPEDIENTE_DIAS=seg-sex
AGENDAMENTO_EXPEDIENTE_INICIO=09:00
AGENDAMENTO_EXPEDIENTE_FIM=18:00

# --- MCP servidor B2B (R12) ---
# MVP: exposto publicamente só com chave estática por parceiro, via HTTPS
# (Caddy na frente, ver infra/caddy/Caddyfile e docs/ARCHITECTURE.md §6).
# Escuta só na própria máquina: o acesso de fora passa pelo Caddy. Trocar por
# 0.0.0.0 pula o HTTPS e a chave trafega em texto claro.
MCP_B2B_HOST=127.0.0.1
MCP_B2B_PORT=8100
# Chaves dos parceiros habilitados: nome:chave,nome2:chave2 (mínimo 16
# caracteres cada). Sem nenhuma chave o servidor NÃO sobe. Os valores abaixo
# são só exemplo: gere chaves reais com
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# e nunca as coloque em commit.
MCP_B2B_PARTNER_KEYS=fornecedor-demo:troque-por-uma-chave-gerada-aqui
# Endereço público pelo qual os parceiros chegam (via Caddy). Vazio = só local.
MCP_B2B_PUBLIC_URL=https://seu-dominio.duckdns.org:8443/mcp

# --- CORS (frontend) ---
# MVP: lista de origens de dev separada por vírgula — sem lista configurável
# por ambiente/parceiro (isso seria necessário para um deploy real)
CORS_ALLOWED_ORIGIN=http://localhost:3001
